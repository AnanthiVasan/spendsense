# Postgres (Neon or any pooled Postgres URL). Do not commit real secrets.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# Auth.js
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Plaid. Leave CLIENT_ID and SECRET empty to use deterministic MOCK mode.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Gemini. Leave empty to use deterministic keyword categorization and mock embeddings.
GEMINI_API_KEY=

# RAG retrieval
RAG_TOP_K=8
MIN_SIMILARITY=0.3

# Anomaly detection (mean + kσ on expenses only)
ANOMALY_SIGMA=2.0
ANOMALY_MIN_CATEGORY_COUNT=5

# Forecast (heuristic numbers; LLM only narrates)
FORECAST_Z=1.64
FORECAST_HORIZON_DAYS=30
FORECAST_STARTING_BALANCE=3500

# Savings goals (discretionary trim; numbers are computed in code)
GOAL_TRIM_PCT=0.15
GOAL_MIN_COUNT=5
# Stripe test mode. Leave STRIPE_SECRET_KEY empty for MOCK checkout (marks the user pro locally).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
NEXT_PUBLIC_APP_URL=http://localhost:3000
